<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light theme. values-night/themes.xml provides the dark version of Base. -->
    <style name="Base.Theme.CatHeavenApp" parent="Theme.Material3.DayNight.NoActionBar" />

    <!-- Brand colours shared by both themes. The colour resources themselves switch
         between values/ and values-night/, so this block stays the same. -->
    <style name="Theme.CatHeavenApp" parent="Base.Theme.CatHeavenApp">
        <item name="colorPrimary">@color/pink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/lightPink</item>
        <item name="colorOnPrimaryContainer">@color/darkColor</item>
        <item name="colorSecondary">@color/pink</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <!-- Material 3 dialogs use this; left unset they fall back to Material's lavender -->
        <item name="colorSurfaceContainerHigh">@color/dialogSurface</item>
        <item name="colorOnSurface">@color/darkColor</item>
        <item name="colorError">@color/errorRed</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <style name="Theme.CatHeavenApp.Launcher" parent="Theme.CatHeavenApp">
        <item name="android:windowBackground">@color/pink</item>
        <item name="android:statusBarColor">@color/pink</item>
        <item name="android:navigationBarColor">@color/pink</item>
    </style>

    <style name="PinkBottomNav">
        <item name="colorSecondaryContainer">@color/pink</item>
    </style>

    <!-- DayNight, so the booking calendar is readable in both themes -->
    <style name="PinkCalendarTheme" parent="ThemeOverlay.AppCompat.DayNight">
        <item name="colorAccent">@color/pink</item>
        <item name="colorPrimary">@color/pink</item>

        <item name="android:textColorPrimary">@color/textColor</item>
    </style>

</resources>
