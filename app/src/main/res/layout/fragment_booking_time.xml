<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".BookingTimeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <LinearLayout
            android:id="@+id/timeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/pink"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pick your time slot."
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/headerDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="28 August 2026"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/durationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Select Duration"
            android:textColor="@color/darkColor"
            android:textSize="14sp"
            android:textAllCaps="true"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/timeHeader" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/durationToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            app:checkedButton="@id/btn1Hour"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/durationLabel"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn1Hour"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/lightPink"
                android:paddingVertical="8dp"
                android:text="1 Hr\nR120pp"
                android:textColor="@color/darkColor"
                app:singleLine="false"
                app:strokeColor="@color/pink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn15Hour"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="8dp"
                android:text="1.5 Hr\nR170pp"
                android:textColor="@color/darkColor"
                app:singleLine="false"
                app:strokeColor="@color/pink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn2Hour"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingVertical="8dp"
                android:text="2 Hr\nR220pp"
                android:textColor="@color/darkColor"
                app:singleLine="false"
                app:strokeColor="@color/pink" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/timesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="Available Times"
            android:textColor="@color/darkColor"
            android:textSize="14sp"
            android:textAllCaps="true"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/durationToggleGroup" />

        <!-- Filled at runtime with one button per timeslot (see item_time_slot.xml) -->
        <GridLayout
            android:id="@+id/timeSlotGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:columnCount="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/timesLabel">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTime10"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:checkable="true"
                android:text="10:00 AM"
                android:textColor="@color/darkColor"
                app:backgroundTint="@color/lightPink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTime11"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:checkable="true"
                android:text="11:00 AM"
                android:textColor="@color/darkColor"
                app:backgroundTint="@color/lightPink" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTime12"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:checkable="true"
                android:text="12:00 PM"
                android:textColor="@color/darkColor"
                app:backgroundTint="@color/lightPink"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTime1"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:checkable="true"
                android:text="1:00 PM"
                android:textColor="@color/darkColor"
                app:backgroundTint="@color/lightPink"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTime2"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:checkable="true"
                android:text="2:00 PM"
                android:textColor="@color/darkColor"
                app:backgroundTint="@color/lightPink"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTime3"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:checkable="true"
                android:text="3:00 PM"
                android:textColor="@color/darkColor"
                app:backgroundTint="@color/lightPink"/>
        </GridLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueTime"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="32dp"
            android:text="Continue"
            android:textSize="16sp"
            app:backgroundTint="@color/pink"
            app:cornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/timeSlotGrid" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>