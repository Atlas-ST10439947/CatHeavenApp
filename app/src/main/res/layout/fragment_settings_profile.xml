<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pink"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="38dp"
            android:layout_marginBottom="90dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit my Profile"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@drawable/cr35bffffff">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="30dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="53dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Jane Smith"
                                android:textColor="#222222"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="38dp"
                            android:layout_marginBottom="30dp"
                            android:text="account settings"
                            android:textColor="#222222"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="38dp"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:id="@+id/rbjd5i5ikqwe"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:id="@+id/rov1lh0dynbd"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="12dp"
                                        android:layout_marginBottom="61dp"
                                        android:orientation="vertical"
                                        android:paddingVertical="1dp"
                                        android:paddingLeft="1dp"
                                        android:paddingRight="20dp">

                                        <TextView
                                            android:id="@+id/ralyiupbvn3b"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Username"
                                            android:textColor="#222222"
                                            android:textSize="16sp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/r7krh1rrq1bl"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="64dp"
                                        android:layout_marginBottom="61dp"
                                        android:text="phone"
                                        android:textColor="#222222"
                                        android:textSize="16sp" />

                                    <TextView
                                        android:id="@+id/rna6rsmf12wr"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="email address"
                                        android:textColor="#222222"
                                        android:textSize="16sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/r9ldh8zf6isu"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="0dp"
                                android:layout_marginTop="26dp"
                                android:background="@drawable/cr10beaeaea"
                                android:orientation="vertical"
                                android:paddingVertical="6dp"
                                android:paddingLeft="20dp"
                                android:paddingRight="266dp">

                                <TextView
                                    android:id="@+id/r2ttgz1lopkg"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Jane Smith"
                                    android:textColor="#222222"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/r97173e35qma"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:layout_marginStart="0dp"
                                android:layout_marginBottom="41dp"
                                android:background="@drawable/cr10beaeaea"
                                android:orientation="vertical"
                                android:paddingVertical="6dp"
                                android:paddingLeft="20dp"
                                android:paddingRight="231dp">

                                <TextView
                                    android:id="@+id/rqadzclil8da"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="+27 123 456 7890"
                                    android:textColor="#1A1115"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </RelativeLayout>

                        <EditText
                            android:id="@+id/rwywfjgq57m"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="38dp"
                            android:layout_marginBottom="30dp"
                            android:background="@drawable/cr10beaeaea"
                            android:hint="jane@example.com"
                            android:inputType="text"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="6dp"
                            android:textColor="#222222"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/r3vgjcy23uxc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="154dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/rdq9nwxhff5l"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/cr30bf2707c"
                                android:clickable="true"
                                android:focusable="true"
                                android:orientation="vertical"
                                android:paddingHorizontal="28dp"
                                android:paddingVertical="5dp">

                                <TextView
                                    android:id="@+id/rvi65mz06agf"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Update Profile"
                                    android:textColor="#222222"
                                    android:textSize="16sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
