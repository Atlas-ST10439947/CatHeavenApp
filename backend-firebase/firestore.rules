rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // An admin either has the 'admin' custom claim, or role == 'admin' on their
    // users document. Users can't set or change their own role (see /users below),
    // so only someone with Firebase console access can make an account an admin.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // An admin can block a supporter's account from the Supporter Directory.
    // Blocked accounts keep their profile and bookings, but can't book, reschedule
    // or enrol (the app also signs them out at login with a "contact us" message).
    function isBlocked() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn() && exists(profile) && get(profile).data.get('blocked', false) == true;
    }

    // A supporter may only change a timeslot as part of the booking transaction.
    // The rise in bookedCount must equal the guests on a booking created in the
    // same write, the slot must stay within capacity, and status must flip to
    // 'full' exactly when capacity is reached. Nothing else on the slot may change.
    function isBookingIncrement(timeslotId) {
      let before = resource.data;
      let after = request.resource.data;
      let bookingPath = /databases/$(database)/documents/bookings/$(after.lastBookingId);
      let booking = getAfter(bookingPath).data;
      let newCount = before.bookedCount + booking.numberOfGuests;
      return signedIn()
        && after.diff(before).affectedKeys().hasOnly(['bookedCount', 'status', 'lastBookingId'])
        && before.status == 'open'
        && !exists(bookingPath)
        && booking.timeslotId == timeslotId
        && booking.supporterId == request.auth.uid
        && after.bookedCount == newCount
        && newCount <= before.capacity
        && after.status == (newCount >= before.capacity ? 'full' : 'open');
    }

    // ---- Admin-written content validation (mirrors ContentValidator.kt in the app) ----

    function optionalText(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    // A date that is either not set (missing/null) or not in the future
    function optionalPastDate(data, key) {
      return data.get(key, null) == null
        || (data[key] is timestamp && data[key] <= request.time);
    }

    function validCat(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 40
        && optionalText(data, 'breed', 40)
        && optionalText(data, 'gender', 20)
        && optionalText(data, 'personality', 60)
        && optionalText(data, 'biography', 1000)
        && data.get('adoptionStatus', 'resident') in ['available', 'pendingAdoption', 'adopted', 'resident']
        // photoUrl names a photo bundled with the app, e.g. "amore"
        && data.get('photoUrl', '') is string
        && data.get('photoUrl', '').matches('[a-z0-9_]{0,60}')
        && optionalPastDate(data, 'dateOfBirth')
        && optionalPastDate(data, 'dateArrived')
        && (data.get('dateOfBirth', null) == null || data.get('dateArrived', null) == null
            || data.dateArrived >= data.dateOfBirth)
        && data.get('updatedAt', request.time) == request.time;
    }

    function validMenuItem(data) {
      return data.keys().hasOnly(['name', 'category', 'price', 'isAvailable', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 60
        && data.category in ['foodAndDrink', 'giftShop']
        && (data.get('price', null) == null
            || (data.price is int && data.price >= 0 && data.price <= 5000))
        && data.get('isAvailable', true) is bool
        && data.get('updatedAt', request.time) == request.time;
    }

    // ---- Supporter cancel / reschedule (mirrors BookingChanges.kt in the app) ----

    function bookingDoc(id) {
      return /databases/$(database)/documents/bookings/$(id);
    }

    function slotDoc(id) {
      return /databases/$(database)/documents/timeslots/$(id);
    }

    // A supporter can move or cancel their own confirmed booking until the day before the visit
    function ownerCanChange(booking) {
      return signedIn()
        && booking.supporterId == request.auth.uid
        && booking.status == 'confirmed'
        && booking.slotDate > request.time;
    }

    // The supporter's booking stops using this slot in the same write, so its seats come back.
    // FULL becomes OPEN; OPEN and CLOSED stay as they are.
    function isSeatRelease(timeslotId) {
      let before = resource.data;
      let after = request.resource.data;
      let bookingBefore = get(bookingDoc(after.lastBookingId)).data;
      let bookingAfter = getAfter(bookingDoc(after.lastBookingId)).data;
      return after.diff(before).affectedKeys().hasOnly(['bookedCount', 'status', 'lastBookingId'])
        && ownerCanChange(bookingBefore)
        && bookingBefore.timeslotId == timeslotId
        && (bookingAfter.status == 'cancelled' || bookingAfter.timeslotId != timeslotId)
        && after.bookedCount == before.bookedCount - bookingBefore.numberOfGuests
        && after.bookedCount >= 0
        && after.status == (before.status == 'full' ? 'open' : before.status);
    }

    // The supporter's existing booking moves onto this slot in the same write
    function isRescheduleIncrement(timeslotId) {
      let before = resource.data;
      let after = request.resource.data;
      let bookingBefore = get(bookingDoc(after.lastBookingId)).data;
      let bookingAfter = getAfter(bookingDoc(after.lastBookingId)).data;
      let newCount = before.bookedCount + bookingBefore.numberOfGuests;
      return after.diff(before).affectedKeys().hasOnly(['bookedCount', 'status', 'lastBookingId'])
        && ownerCanChange(bookingBefore)
        && bookingBefore.timeslotId != timeslotId
        && bookingAfter.timeslotId == timeslotId
        && bookingAfter.status == 'confirmed'
        && before.status == 'open'
        && after.bookedCount == newCount
        && newCount <= before.capacity
        && after.status == (newCount >= before.capacity ? 'full' : 'open');
    }

    function slotCountChange(slotId) {
      return getAfter(slotDoc(slotId)).data.bookedCount - get(slotDoc(slotId)).data.bookedCount;
    }

    // Cancel: only the status fields change, and the slot gives the seats back in the same write
    function isOwnerCancel() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return ownerCanChange(resource.data)
        && changed.hasOnly(['status', 'cancelledAt', 'cancelledBy'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == 'supporter'
        && request.resource.data.cancelledAt == request.time
        && slotCountChange(resource.data.timeslotId) == -resource.data.numberOfGuests;
    }

    // Reschedule: only the slot fields change, to a future slot whose details match,
    // with the seats moved from the old slot to the new one in the same write
    function isOwnerReschedule() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let next = request.resource.data;
      let newSlot = getAfter(slotDoc(next.timeslotId)).data;
      return ownerCanChange(resource.data)
        && changed.hasOnly(['timeslotId', 'slotDate', 'slotStart', 'rescheduledAt'])
        && next.timeslotId != resource.data.timeslotId
        && next.rescheduledAt == request.time
        && next.slotDate == newSlot.date
        && next.slotStart == newSlot.startTime
        && next.slotDate > request.time
        && slotCountChange(next.timeslotId) == resource.data.numberOfGuests
        && (!exists(slotDoc(resource.data.timeslotId))
            || slotCountChange(resource.data.timeslotId) == -resource.data.numberOfGuests);
    }

    // Public catalogue - anyone can read, only admins can write, and writes must be valid
    match /cats/{catId} {
      allow read: if true;
      allow create, update: if isAdmin() && validCat(request.resource.data);
      allow delete: if isAdmin();

      match /updates/{updateId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /timeslots/{timeslotId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || isBookingIncrement(timeslotId)
                    || isRescheduleIncrement(timeslotId)
                    || isSeatRelease(timeslotId);
    }

    match /pricingTiers/{tierId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menuItems/{menuItemId} {
      allow read: if true;
      allow create, update: if isAdmin() && validMenuItem(request.resource.data);
      allow delete: if isAdmin();
    }

    // ---- Profile validation (mirrors ProfileValidator.kt in the app) ----

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 80;
    }

    // Empty, or an optional leading + followed by 7-20 digits or spaces
    function validPhone(phone) {
      return phone is string && (phone == '' || phone.matches('[+]?[0-9 ]{7,20}'));
    }

    function validNotificationPrefs(prefs) {
      return prefs is map
        && prefs.keys().hasOnly(['email', 'inApp'])
        && prefs.get('email', true) is bool
        && prefs.get('inApp', true) is bool;
    }

    // Supporters may only change these fields, and each one that changes must be valid.
    // role, email and dateJoined can never be edited from the app.
    function validProfileChange() {
      let data = request.resource.data;
      return changedKeys().hasOnly(['fullName', 'phone', 'location', 'notificationPrefs'])
        && (!('fullName' in changedKeys()) || validName(data.fullName))
        && (!('phone' in changedKeys()) || validPhone(data.phone))
        && (!('location' in changedKeys()) || (data.location is string && data.location.size() <= 100))
        && (!('notificationPrefs' in changedKeys()) || validNotificationPrefs(data.notificationPrefs));
    }

    // An admin may only flip 'blocked' on a supporter's profile: never on an admin
    // account (including their own), and nothing else on the profile changes.
    // Supporters can't change 'blocked' themselves, because validProfileChange()
    // doesn't allow that field.
    function isAdminBlockChange(uid) {
      return isAdmin()
        && request.auth.uid != uid
        && resource.data.get('role', '') != 'admin'
        && changedKeys().hasOnly(['blocked'])
        && request.resource.data.blocked is bool;
    }

    // User accounts - the owner reads and edits their own profile; admins can read all
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                    && request.resource.data.role == 'supporter'
                    && request.resource.data.keys().hasOnly(['fullName', 'email', 'phone', 'role', 'dateJoined'])
                    && validName(request.resource.data.fullName);
      allow update: if (isOwner(uid) && validProfileChange()) || isAdminBlockChange(uid);
      allow delete: if isAdmin();
    }

    // Bookings - supporters create their own, 1 to 8 guests, and only together
    // with the matching timeslot update (see isBookingIncrement above)
    match /bookings/{bookingId} {
      allow read: if isAdmin() ||
                     (signedIn() && resource.data.supporterId == request.auth.uid);

      allow create: if signedIn()
                    && !isBlocked()
                    && request.resource.data.supporterId == request.auth.uid
                    && request.resource.data.numberOfGuests > 0
                    && request.resource.data.numberOfGuests <= 8
                    && request.resource.data.status == 'confirmed'
                    && request.resource.data.totalDue ==
                         request.resource.data.pricePerPerson * request.resource.data.numberOfGuests
                    && request.resource.data.createdAt == request.time
                    && getAfter(/databases/$(database)/documents/timeslots/$(request.resource.data.timeslotId))
                         .data.lastBookingId == bookingId;

      // Admins can change anything; supporters can only cancel or reschedule their own
      allow update: if isAdmin() || (!isBlocked() && (isOwnerCancel() || isOwnerReschedule()));
      allow delete: if isAdmin();
    }

    // Paw Parent enrolments
    match /pawParentEnrolments/{enrolmentId} {
      allow read: if isAdmin() ||
                     (signedIn() && resource.data.supporterId == request.auth.uid);

      allow create: if signedIn()
                    && !isBlocked()
                    && request.resource.data.supporterId == request.auth.uid;

      allow update: if isAdmin() ||
                       (signedIn() && resource.data.supporterId == request.auth.uid
                        && request.resource.data.status == 'cancelled');

      allow delete: if isAdmin();
    }
  }
}
